# ---------------------------------------------------------------
#  Noor wa Sakina API — environment variables
#  Copy this file to `.env` for local development.
#  On Render, add the same keys under Environment.
# ---------------------------------------------------------------

# Port (Render sets this automatically)
PORT=4000

# PostgreSQL connection string.
# Supabase: Project → Connect → "Session pooler" URI (IPv4, works on Render free).
# Example:
# DATABASE_URL=postgresql://postgres.abcdefghijkl:YOUR-PASSWORD@aws-0-eu-central-1.pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/noor_wasakina

# true for Supabase / Neon / Render Postgres, false for a local database
DATABASE_SSL=false

# Admin key for /admin and protected endpoints (header: x-admin-secret).
# Use a long random value (at least 12 characters), e.g.:  openssl rand -hex 24
ADMIN_SECRET=change-me-to-a-long-random-secret

# Comma-separated list of frontend origins allowed to call the API (no trailing slash).
# Leave empty to allow all origins (fine for local development only).
CORS_ORIGINS=http://localhost:5173

# Create tables + seed data automatically on startup (true/false)
AUTO_MIGRATE=true

# Time zone used to rotate the daily quote at local midnight
QUOTE_TIMEZONE=Asia/Amman
